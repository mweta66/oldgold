HOST=127.0.0.1
PORT=8000
STORAGE_PROVIDER=supabase
# Server-side only: copy these from your own Supabase project's API settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Production: set your HTTPS site origin and COOKIE_SECURE=true in Vercel.
# PUBLIC_ORIGIN=https://your-domain.example
COOKIE_SECURE=false
# Local bootstrap only: run npm run supabase:bootstrap, then remove the password.
# No default administrator/password is shipped. First login requires replacement.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Server-side only. Create a bot via BotFather; never commit real values.
TELEGRAM_BOT_TOKEN=
# Optional: an internal ADMIN group. Subscriber quotas require private messages.
TELEGRAM_ADMIN_CHAT_ID=
# Random secrets for the Telegram webhook and authenticated retry job.
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
# Legacy SQLite dev mode only: remove STORAGE_PROVIDER and Supabase variables.
# DATABASE_PATH=./data/wetagold.sqlite
# BACKUP_DIR=./data/backups
# ADMIN_REQUIRE_PASSWORD_CHANGE=true
