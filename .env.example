HOST=127.0.0.1
PORT=8000
STORAGE_PROVIDER=supabase
# Server-side only: copy these from your own Supabase project's API settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Production: set your HTTPS site origin and COOKIE_SECURE=true in Vercel.
# PUBLIC_ORIGIN=https://your-domain.example
COOKIE_SECURE=false
# Local bootstrap only: run npm run supabase:bootstrap, then remove the password.
# No default administrator/password is shipped. First login requires replacement.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Server-side only. Create a bot via BotFather; never commit real values.
TELEGRAM_BOT_TOKEN=
# Private signals group. Only the owner manually adds/removes subscribers.
# The group sees ALL signals; website quotas do not restrict shared group history.
TELEGRAM_GROUP_CHAT_ID=
# Legacy alias TELEGRAM_ADMIN_CHAT_ID is supported; prefer the variable above.
# Random secrets for the Telegram webhook and authenticated retry job.
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
# MT5 chart only. Enable only after migration 014 and a verified fresh broker quote.
# The signal engine remains on Gold API until a separately tested source cutover.
MT5_CHART_ENABLED=false
MT5_SYMBOL=XAUUSD
MT5_SERVER=MetaQuotes-Demo
MT5_BRIDGE_TOKEN=
# Legacy SQLite dev mode only: remove STORAGE_PROVIDER and Supabase variables.
# DATABASE_PATH=./data/wetagold.sqlite
# BACKUP_DIR=./data/backups
# ADMIN_REQUIRE_PASSWORD_CHANGE=true
