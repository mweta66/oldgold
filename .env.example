HOST=127.0.0.1
PORT=8000
DATABASE_PATH=./data/wetagold.sqlite
BACKUP_DIR=./data/backups
# For HTTPS deployment, set the external origin and enable secure cookies.
# PUBLIC_ORIGIN=https://your-domain.example
COOKIE_SECURE=false
# First-start bootstrap only. No default administrator/password is shipped.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Server-side only. Create a bot via BotFather; never commit real values.
TELEGRAM_BOT_TOKEN=
# Optional: an internal ADMIN group. Subscriber quotas require private messages.
TELEGRAM_ADMIN_CHAT_ID=
