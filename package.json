{
  "name": "xgold",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "build:static": "node scripts/build-static.js",
    "start": "node --use-env-proxy --env-file-if-exists=.env server.js",
    "supabase:bootstrap": "node --use-env-proxy --env-file-if-exists=.env scripts/bootstrap-supabase.js",
    "telegram:webhook": "node --use-env-proxy --env-file-if-exists=.env scripts/telegram-webhook.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/browser.e2e.js",
    "check": "node scripts/check-js.js",
    "format:check": "prettier --check index.html styles.css app.js time-zones.js trade-export.js server.js lib test api scripts package.json manifest.webmanifest vercel.json README.md docs .github"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.10",
    "@fontsource-variable/cairo": "5.3.0",
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "countries-and-timezones": "3.11.0"
  }
}
